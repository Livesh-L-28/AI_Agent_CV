# SENTINEL AI Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (SQLite default for local dev; PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_db

# Computer Vision & Model Inference
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=auto  # "auto", "cpu", "mps", "cuda"
INFERENCE_IMAGE_SIZE=640

# Temporal Rules & Restricted Zones
ZONE_PERSISTENCE_FRAMES=5
PPE_PERSISTENCE_FRAMES=6
EVENT_COOLDOWN_SECONDS=10.0

# LLM & Agent Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
LLM_PROVIDER=ollama  # "ollama", "openai", "mock"
ENABLE_MOCK_LLM=false

# Media Storage
EVIDENCE_STORAGE_PATH=./data/evidence
UPLOAD_STORAGE_PATH=./data/uploads
FIXTURES_PATH=./data/fixtures

# Server & Network
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
